# Universe gateway API defaults.
AUTONOMOUS_UNIVERSE_RUN_DIR=runs/latest
AUTONOMOUS_UNIVERSE_RUN_SELECTION=auto
AUTONOMOUS_REDIS_URL=redis://redis:6379/0
AUTONOMOUS_UNIVERSE_POSTGRES_DSN=postgresql://robot:robot@postgres:5432/robot
AUTONOMOUS_JWT_SECRET=change-me
AUTONOMOUS_LOG_LEVEL=INFO
AUTONOMOUS_UNIVERSE_GATEWAY_HOST=0.0.0.0
AUTONOMOUS_UNIVERSE_GATEWAY_PORT=8081
