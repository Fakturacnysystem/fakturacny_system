# Realtime projection worker defaults.
AUTONOMOUS_REDIS_URL=redis://redis:6379/0
AUTONOMOUS_UNIVERSE_POSTGRES_DSN=postgresql://robot:robot@postgres:5432/robot
AUTONOMOUS_UNIVERSE_RT_GROUP=universe_realtime
AUTONOMOUS_UNIVERSE_RT_CONSUMER=realtime-worker
AUTONOMOUS_UNIVERSE_TELEMETRY_FLUSH_S=0.2
AUTONOMOUS_LOG_LEVEL=INFO
