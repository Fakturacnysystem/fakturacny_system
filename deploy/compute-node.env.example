# Compute-node environment template (no secrets stored here).

AUTONOMOUS_RUN_DIR=runs/compute_node
AUTONOMOUS_NODE_ROLE=compute
AUTONOMOUS_DISTRIBUTED_ENABLED=1
AUTONOMOUS_COMPUTE_BRIDGE=redis
AUTONOMOUS_REDIS_URL=redis://redis:6379/0
AUTONOMOUS_STREAM_PREFIX=autobot
AUTONOMOUS_STREAM_PAYLOAD_VERSION=v1
AUTONOMOUS_COMPUTE_WORKER_BLOCK_MS=800
AUTONOMOUS_COMPUTE_WORKER_IDLE_SLEEP_S=0.2
AUTONOMOUS_COMPUTE_STREAM_MAXLEN=5000

# Mirror compute diagnostics into Postgres for shared observability.
AUTONOMOUS_POSTGRES_MIRROR_ENABLED=1
AUTONOMOUS_POSTGRES_DSN=postgresql://robot:robot@postgres:5432/robot

# Advisory provider runs here (optional, non-blocking for live node).
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_PRIMARY=openai/gpt-oss-120b
LLM_MODEL_FALLBACK=openai/gpt-oss-20b
LLM_ENABLED=1

# Optional keys injected by runtime secret store:
# GROQ_API_KEY=...
# OPENAI_API_KEY=...

# Universe projection worker compatibility.
AUTONOMOUS_UNIVERSE_POSTGRES_DSN=postgresql://robot:robot@postgres:5432/robot
