# Live-node environment template (no secrets stored here).

AUTONOMOUS_CONFIG_PATH=config.kraken_spot.live_profit.yaml
AUTONOMOUS_RUN_DIR=runs/kraken_spot_live_profit_full_throttle
AUTONOMOUS_PROFILE=ultra_profit_full_throttle
AUTONOMOUS_RUN_PROFILE=ULTRA_PROFIT_FULL_THROTTLE

# Distributed runtime.
AUTONOMOUS_NODE_ROLE=live
AUTONOMOUS_DISTRIBUTED_ENABLED=1
AUTONOMOUS_COMPUTE_BRIDGE=redis
AUTONOMOUS_COMPUTE_TASK_TIMEOUT_S=0.8
AUTONOMOUS_COMPUTE_REFRESH_S=10
AUTONOMOUS_COMPUTE_TOP_N=24
AUTONOMOUS_COMPUTE_ALLOW_LOCAL_FALLBACK=1
AUTONOMOUS_COMPUTE_ENFORCE_REMOTE=0
AUTONOMOUS_STREAM_PREFIX=autobot
AUTONOMOUS_STREAM_PAYLOAD_VERSION=v1
AUTONOMOUS_REDIS_URL=redis://redis:6379/0

# Hybrid persistence mirror.
AUTONOMOUS_POSTGRES_MIRROR_ENABLED=1
AUTONOMOUS_POSTGRES_DSN=postgresql://robot:robot@postgres:5432/robot
AUTONOMOUS_POSTGRES_CONNECT_TIMEOUT_S=2

# Runtime tuning defaults (safe midpoint).
AUTONOMOUS_TRADES_SYNC_MIN_INTERVAL_S=60
AUTONOMOUS_KRAKEN_BALANCE_TTL_S=30
AUTONOMOUS_KRAKEN_TRADES_TTL_S=45
AUTONOMOUS_CONFIDENCE_THRESHOLD=0.44
AUTONOMOUS_LIQUIDITY_NIGHT_EDGE_ADD_BPS=1.5
AUTONOMOUS_ORDER_CADENCE_S=9
AUTONOMOUS_RISK_PER_TRADE=0.0025
AUTONOMOUS_MAX_PORTFOLIO_HEAT_RATIO=0.0125

# xStocks mixed-universe defaults.
AUTONOMOUS_ENABLE_XSTOCKS=true
AUTONOMOUS_ENABLE_XSTOCKS_ETF=true
AUTONOMOUS_MIXED_UNIVERSE_MODE=true
AUTONOMOUS_XSTOCKS_SESSION_AWARE=true
AUTONOMOUS_XSTOCKS_ALLOW_OFF_HOURS=false

# Optional advisory provider (kept non-blocking).
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_PRIMARY=openai/gpt-oss-120b
LLM_MODEL_FALLBACK=openai/gpt-oss-20b
LLM_ENABLED=1
AUTONOMOUS_DISABLE_ADVISORY_ON_LIVE_NODE=1

# Live exchange credentials are injected at runtime by your secret manager or shell.
# KRAKEN_API_KEY=...
# KRAKEN_API_SECRET=...
