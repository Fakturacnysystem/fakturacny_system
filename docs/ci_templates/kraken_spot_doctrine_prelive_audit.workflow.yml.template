name: Kraken Spot Doctrine Prelive Audit

on:
  push:
    branches:
      - main
      - 'codex/**'
  pull_request:
  workflow_dispatch:

jobs:
  prelive-audit:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    env:
      PYTHONPATH: src
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install project and audit dependencies
        run: |
          python -m pip install --upgrade pip
          python -m pip install -e .
          python -m pip install pytest ccxt pyyaml

      - name: Compile all Python sources
        run: |
          python3 -m py_compile $(find src -name '*.py' -print) dashboard.py live_production_master.py god_mode_launcher.py

      - name: Run doctrine and launch-gate targeted tests
        run: |
          pytest -q \
            tests/test_execution_risk_settings.py \
            tests/test_launch_path_safety.py \
            tests/test_harmony_market_watch.py \
            tests/test_live_kraken_spot_service.py

      - name: Run provider and observability regression tests
        run: |
          pytest -q \
            tests/test_kraken_provider.py \
            tests/test_market_integrity_service.py \
            tests/test_orchestrator_observability.py \
            tests/test_config_truthfulness.py

      - name: Run full pytest
        run: |
          pytest -q

      - name: Validate config matrix
        run: |
          ./scripts/validate_config_matrix.py

      - name: Run contradiction audit
        run: |
          python3 ./scripts/run_contradiction_audit.py

      - name: Scan tracked secrets
        run: |
          ./scripts/scan_tracked_secrets.sh

      - name: Smoke launch gates without sending orders
        run: |
          env -i PATH="$PATH" HOME="$HOME" PYTHONPATH=src bash ./scripts/run_kraken_spot_profit_full_throttle.sh || true
          PYTHONPATH=src python3 -m autonomous_investment_robot live --config config.kraken_derivatives.testnet.yaml
          PYTHONPATH=src python3 -m autonomous_investment_robot live-readonly --config config.kraken_derivatives.live_readonly.yaml
