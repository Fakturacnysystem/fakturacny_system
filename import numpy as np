    def nowcast_market_conditions(self, ctx) -> dict:
        """Nowcast short-term (micro) market conditions."""
        return {
            "micro_trend": ctx.market_watch.get("trend_30s_bps", 0.0),
            "micro_vol": ctx.market_watch.get("realized_vol_2m", 0.0),
            "spread": ctx.spread_bps,
        }

    def estimate_market_state(self, ctx) -> dict:
        """Estimate tactical and strategic market state."""
        return {
            "tactical_trend": ctx.market_watch.get("trend_2m_bps", 0.0),
            "strategic_trend": ctx.market_watch.get("trend_10m_bps", 0.0),
            "macro_risk_on": ctx.features.get("macro_risk_on", 0.0),
        }

    def generate_trade_signal(self, ctx) -> dict:
        """Fuse multi-horizon signals into a trade signal."""
        micro = self.nowcast_market_conditions(ctx)
        state = self.estimate_market_state(ctx)
        # Jednoduchá vážená fúzia (prispôsobte podľa potreby)
        score = (
            0.5 * micro["micro_trend"] +
            0.3 * state["tactical_trend"] +
            0.2 * state["strategic_trend"]
        )
        return {"signal_score": score}

    def decide_trade_entry(self, ctx, signal: dict) -> bool:
        """Rozhodnutie o vstupe na základe multi-horizon signálu."""
        return signal["signal_score"] > self.confidence_threshold

    def decide_trade_exit(self, ctx, signal: dict) -> bool:
        """Rozhodnutie o exite na základe multi-horizon signálu."""
        return signal["signal_score"] < -self.confidence_threshold

    def manage_open_position(self, ctx, signal: dict) -> str:
        """Správa otvorenej pozície: hold, add, reduce, close."""
        if self.decide_trade_exit(ctx, signal):
            return "close"
        elif self.decide_trade_entry(ctx, signal):
            return "add"
        return "hold"

    def detect_market_regime(self, ctx) -> dict:
        """Detect current market regime based on multi-horizon features."""
        regime = {}
        # Microstructure regime
        if ctx.spread_bps > 100:
            regime["microstructure"] = "stress"
        else:
            regime["microstructure"] = "normal"
        # Volatility regime
        vol = ctx.market_watch.get("realized_vol_2m", 0.0)
        if vol > 0.08:
            regime["volatility"] = "high"
        elif vol < 0.02:
            regime["volatility"] = "low"
        else:
            regime["volatility"] = "normal"
        # Trend regime
        trend = ctx.market_watch.get("trend_10m_bps", 0.0)
        if trend > 50:
            regime["trend"] = "bull"
        elif trend < -50:
            regime["trend"] = "bear"
        else:
            regime["trend"] = "sideways"
        # Liquidity regime
        liquidity = ctx.features.get("liquidity_pressure", 0.0)
        regime["liquidity"] = "tight" if liquidity > 0.7 else "normal"
        # Risk-on/off regime
        risk_on = ctx.features.get("macro_risk_on", 0.0)
        regime["risk"] = "risk_on" if risk_on > 0.5 else "risk_off"
        # Compression/breakout/panic/chop
        if vol < 0.015 and abs(trend) < 10:
            regime["structure"] = "compression"
        elif vol > 0.09 and abs(trend) > 80:
            regime["structure"] = "breakout"
        elif vol > 0.12:
            regime["structure"] = "panic"
        else:
            regime["structure"] = "chop"
        return regime

    def switch_trading_regime(self, ctx, detected_regime: dict) -> str:
        """Switch trading logic based on detected regime."""
        if detected_regime.get("structure") == "panic":
            return "pause"
        if detected_regime.get("microstructure") == "stress":
            return "reduce_size"
        if detected_regime.get("trend") == "bull":
            return "prefer_long"
        if detected_regime.get("trend") == "bear":
            return "hold"
        return "normal"

