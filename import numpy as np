def _base_context():
    class DummyCtx:
        def __init__(self):
            self.market_watch = {
                "trend_30s_bps": 0.0,
                "trend_2m_bps": 0.0,
                "trend_10m_bps": 0.0,
                "realized_vol_2m": 0.0,
            }
            self.spread_bps = 0.0
            self.features = {
                "macro_risk_on": 0.0,
                "liquidity_pressure": 0.0,
                "expected_return": 0.0,
                "expected_volatility": 0.01,
            }
    return DummyCtx()

def test_decision_engine_multi_horizon_signal_fusion():
    engine = AutonomousMarketPredictionAndDecisionEngine(confidence_threshold=0.5)
    ctx = _base_context()
    ctx.market_watch["trend_30s_bps"] = 20.0
    ctx.market_watch["trend_2m_bps"] = 40.0
    ctx.market_watch["trend_10m_bps"] = 80.0
    out = engine.run_decision_algorithm(ctx)
    assert "signal_score" in out.diagnostics or hasattr(out, "diagnostics")
    assert out.action in {"open", "add", "hold", "skip"}

def test_detect_market_regime_basic():
    engine = AutonomousMarketPredictionAndDecisionEngine()
    ctx = _base_context()
    ctx.spread_bps = 120
    ctx.market_watch["realized_vol_2m"] = 0.09
    ctx.market_watch["trend_10m_bps"] = 60
    ctx.features["liquidity_pressure"] = 0.8
    ctx.features["macro_risk_on"] = 0.6
    regime = engine.detect_market_regime(ctx)
    assert regime["microstructure"] == "stress"
    assert regime["volatility"] == "high"
    assert regime["trend"] == "bull"
    assert regime["liquidity"] == "tight"
    assert regime["risk"] == "risk_on"
    assert regime["structure"] in {"breakout", "panic", "chop", "compression"}

def test_switch_trading_regime_behavior():
    engine = AutonomousMarketPredictionAndDecisionEngine()
    ctx = _base_context()
    regime = {
        "structure": "panic",
        "microstructure": "normal",
        "trend": "bull"
    }
    action = engine.switch_trading_regime(ctx, regime)
    assert action == "pause"

