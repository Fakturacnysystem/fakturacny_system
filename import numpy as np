    def forecast_return_distribution(
        self, 
        features: Dict[str, Any], 
        horizon_s: int = 60
    ) -> Dict[str, Any]:
        """
        Forecast the return distribution over the specified horizon.
        Returns dict with mean, std, quantiles, and full distribution array.
        """
        # Example: Use a normal approximation (replace with model if available)
        mu = features.get("expected_return", 0.0)
        sigma = features.get("expected_volatility", 0.01)
        dist = np.random.normal(mu, sigma, 10000)
        quantiles = np.percentile(dist, [5, 25, 50, 75, 95])
        return {
            "mean": float(np.mean(dist)),
            "std": float(np.std(dist)),
            "quantiles": quantiles.tolist(),
            "distribution": dist.tolist()  # For diagnostics, not for logging
        }

    def forecast_volatility_distribution(
        self, 
        features: Dict[str, Any], 
        horizon_s: int = 60
    ) -> Dict[str, Any]:
        """
        Forecast the volatility distribution over the specified horizon.
        Returns dict with mean, std, quantiles, and full distribution array.
        """
        sigma = features.get("expected_volatility", 0.01)
        dist = np.abs(np.random.normal(sigma, sigma * 0.5, 10000))
        quantiles = np.percentile(dist, [5, 25, 50, 75, 95])
        return {
            "mean": float(np.mean(dist)),
            "std": float(np.std(dist)),
            "quantiles": quantiles.tolist(),
            "distribution": dist.tolist()
        }

    def forecast_drawdown_risk(
        self, 
        features: Dict[str, Any], 
        horizon_s: int = 60
    ) -> Dict[str, Any]:
        """
        Estimate downside/drawdown risk over the specified horizon.
        Returns dict with max drawdown, expected drawdown, and quantiles.
        """
        returns = np.random.normal(
            features.get("expected_return", 0.0), 
            features.get("expected_volatility", 0.01), 
            10000
        )
        cum_returns = np.cumprod(1 + returns / 100)
        drawdowns = 1 - cum_returns / np.maximum.accumulate(cum_returns)
        max_drawdown = np.max(drawdowns)
        quantiles = np.percentile(drawdowns, [5, 25, 50, 75, 95])
        return {
            "max_drawdown": float(max_drawdown),
            "quantiles": quantiles.tolist(),
            "distribution": drawdowns.tolist()
        }

    def quantify_prediction_uncertainty(
        self, 
        forecast: Dict[str, Any]
    ) -> float:
        """
        Quantify uncertainty of a forecast (e.g., std/mean ratio).
        """
        mean = forecast.get("mean", 0.0)
        std = forecast.get("std", 0.0)
        if abs(mean) > 1e-8:
            return float(std / abs(mean))
        return float(std)

    def build_conformal_prediction_interval(
        self, 
        forecast: Dict[str, Any], 
        alpha: float = 0.1
    ) -> Tuple[float, float]:
        """
        Build a conformal prediction interval at (1-alpha) confidence.
        """
        lower = np.percentile(forecast["distribution"], 100 * (alpha / 2))
        upper = np.percentile(forecast["distribution"], 100 * (1 - alpha / 2))
        return float(lower), float(upper)

    def score_signal_confidence(
        self, 
        forecast: Dict[str, Any]
    ) -> float:
        """
        Score signal confidence (e.g., Sharpe-like or quantile separation).
        """
        mean = forecast.get("mean", 0.0)
        std = forecast.get("std", 1e-8)
        return float(mean / std if std > 1e-8 else 0.0)

    def analyze_order_flow_imbalance(self, ctx) -> float:
        """Estimate order flow imbalance (OFI) as a proxy for pressure."""
        buy_vol = ctx.features.get("buy_volume", 0.0)
        sell_vol = ctx.features.get("sell_volume", 0.0)
        total = buy_vol + sell_vol
        if total == 0:
            return 0.0
        return (buy_vol - sell_vol) / total

    def model_limit_order_book(self, ctx) -> dict:
