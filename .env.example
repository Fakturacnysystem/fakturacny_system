# Safe defaults: paper mode + no live
ROBOT_TRADING_MODE=paper
ROBOT_EXPLICIT_LIVE_ENABLE=false
ROBOT_SAFE_MODE_DEFAULT=true

# Provider auth/compliance
ROBOT_COMPLIANCE__ALLOWED_PROVIDERS=binance_testnet
ROBOT_COMPLIANCE__MICA_REGISTER_URL=UNSPECIFIED

# Keys (stubs)
BINANCE_API_KEY=UNSPECIFIED
