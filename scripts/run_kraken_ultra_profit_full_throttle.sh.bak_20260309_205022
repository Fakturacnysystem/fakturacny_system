export AUTONOMOUS_REGIME_SIZE_MULT_RANGE="${AUTONOMOUS_REGIME_SIZE_MULT_RANGE:-0.95}"
export AUTONOMOUS_REGIME_SIZE_MULT_CHOP="${AUTONOMOUS_REGIME_SIZE_MULT_CHOP:-0.80}"
